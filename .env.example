# Canonical site URL, used for metadata, sitemap, and JSON-LD. Set this to
# the real production domain once deployed.
NEXT_PUBLIC_SITE_URL=https://ai-tools-hub.example.com

# Optional. Set to your domain to opt into privacy-friendly Plausible
# analytics (no cookies, no personal data). Leave unset to ship with no
# analytics at all — nothing loads unless this is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
